FoamFile
{
    format ascii;
    class dictionary;
    object turbulenceProperties;
}

simulationType RAS;

RAS
{
    RASModel kOmegaSST2003RC;
    turbulence on;
    printCoeffs on;

    kOmegaSST2003RCCoeffs
    {
        curvatureCorrection on;
        Cr1 1.0;
        Cr2 2.0;
        Cr3 1.0;
        frMin 0.0;
        frMax 1.25;
    }
}
