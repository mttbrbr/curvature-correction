#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

cd "${0%/*}" || exit 1
startSeconds=$(date +%s)

./Allrun
CURVATURE_SKIP_BUILD=1 ./Allrun-restartMPI
CURVATURE_SKIP_BUILD=1 ./Allrun-gridStudy

elapsed=$(( $(date +%s) - startSeconds ))
printf 'Complete extended validation time: %d min %d s\n' $((elapsed / 60)) $((elapsed % 60))
if [ "$elapsed" -gt 1800 ]; then
    echo "ERROR: complete extended validation exceeded 30 minutes" >&2
    exit 1
fi

echo "All quick, restart/MPI, and multi-grid checks passed"
