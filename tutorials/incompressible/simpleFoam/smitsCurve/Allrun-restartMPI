#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

cd "${0%/*}" || exit 1
: "${WM_PROJECT_DIR:?OpenFOAM environment is not loaded}"

tutorialDir=$(pwd)
repoDir=$(cd "$tutorialDir/../../../.." && pwd)
resultsDir="$tutorialDir/runs/restart-mpi"
meshCase="$resultsDir/_mesh"
initialCase="$resultsDir/_initial"
nProcs=${CURVATURE_MPI_PROCS:-4}
startSeconds=$(date +%s)

if ! python3 "$repoDir/tools/fetch_benchmark_data.py" --case smits --verify-only >/dev/null; then
    echo "ERROR: benchmark inputs are absent or invalid. Run:" >&2
    echo "  python3 tools/fetch_benchmark_data.py --case smits" >&2
    exit 2
fi

if [ "$nProcs" -lt 2 ]; then
    echo "ERROR: CURVATURE_MPI_PROCS must be at least 2" >&2
    exit 1
fi

rm -rf "$resultsDir"
mkdir -p "$resultsDir"

if [ "${CURVATURE_SKIP_BUILD:-0}" != 1 ]; then
    echo "Building libcurvatureCorrectionModels.so"
    (cd "$repoDir/src/curvatureCorrectionModels" && wmake libso)
fi

echo "Preparing the 129x49 restart/MPI mesh"
cp -a "$tutorialDir/baseCase" "$meshCase"
plot3dToFoam -case "$meshCase" -2D 0.01 -noBlank "$tutorialDir/resources/smits_3levdn_129x49.p2dfmt" > "$meshCase/log.plot3dToFoam" 2>&1
autoPatch -case "$meshCase" -overwrite 20 > "$meshCase/log.autoPatch" 2>&1
createPatch -case "$meshCase" -overwrite > "$meshCase/log.createPatch" 2>&1
checkMesh -case "$meshCase" > "$meshCase/log.checkMesh" 2>&1
grep -q "Number of regions: 1 (OK)" "$meshCase/log.checkMesh"

echo "Preparing identical potential-flow initial conditions"
cp -a "$tutorialDir/baseCase" "$initialCase"
cp -a "$meshCase/constant/polyMesh" "$initialCase/constant/"
cp -a "$initialCase/0.orig" "$initialCase/0"
foamDictionary "$initialCase/constant/turbulenceProperties" -entry RAS/RASModel -set kOmegaSST2003RC
foamDictionary "$initialCase/constant/turbulenceProperties" -entry RAS/kOmegaSST2003RCCoeffs/curvatureCorrection -set on
foamDictionary "$initialCase/system/controlDict" -entry writeInterval -set 50
foamDictionary "$initialCase/system/controlDict" -entry purgeWrite -set 0
potentialFoam -case "$initialCase" -writep > "$initialCase/log.potentialFoam" 2>&1

cp -a "$initialCase" "$resultsDir/continuous"
cp -a "$initialCase" "$resultsDir/checkpoint"
foamDictionary "$resultsDir/checkpoint/system/fvSolution" -entry SIMPLE/residualControl -remove

echo "Running uninterrupted serial reference to convergence"
foamDictionary "$resultsDir/continuous/system/controlDict" -entry endTime -set 1000
simpleFoam -case "$resultsDir/continuous" > "$resultsDir/continuous/log.simpleFoam" 2>&1
grep -q '^End$' "$resultsDir/continuous/log.simpleFoam"
grep -q "SIMPLE solution converged" "$resultsDir/continuous/log.simpleFoam"

echo "Writing serial checkpoint: iterations 0-50"
foamDictionary "$resultsDir/checkpoint/system/controlDict" -entry endTime -set 50
simpleFoam -case "$resultsDir/checkpoint" > "$resultsDir/checkpoint/log.simpleFoam-stage1" 2>&1
grep -q '^End$' "$resultsDir/checkpoint/log.simpleFoam-stage1"
test -d "$resultsDir/checkpoint/50"

cp -a "$resultsDir/checkpoint" "$resultsDir/serial-restart"
cp -a "$resultsDir/checkpoint" "$resultsDir/mpi-restart"
cp "$initialCase/system/fvSolution" "$resultsDir/serial-restart/system/fvSolution"
cp "$initialCase/system/fvSolution" "$resultsDir/mpi-restart/system/fvSolution"

echo "Restarting in serial from 50 to convergence"
foamDictionary "$resultsDir/serial-restart/system/controlDict" -entry startFrom -set latestTime
foamDictionary "$resultsDir/serial-restart/system/controlDict" -entry endTime -set 1000
simpleFoam -case "$resultsDir/serial-restart" > "$resultsDir/serial-restart/log.simpleFoam-stage2" 2>&1
grep -q '^End$' "$resultsDir/serial-restart/log.simpleFoam-stage2"
grep -q "SIMPLE solution converged" "$resultsDir/serial-restart/log.simpleFoam-stage2"

echo "Restarting with MPI ($nProcs ranks) from 50 to convergence"
foamDictionary "$resultsDir/mpi-restart/system/controlDict" -entry startFrom -set latestTime
foamDictionary "$resultsDir/mpi-restart/system/controlDict" -entry endTime -set 1000
foamDictionary "$resultsDir/mpi-restart/system/decomposeParDict" -entry numberOfSubdomains -set "$nProcs"
decomposePar -case "$resultsDir/mpi-restart" -force -latestTime > "$resultsDir/mpi-restart/log.decomposePar" 2>&1
mpirun -np "$nProcs" simpleFoam -case "$resultsDir/mpi-restart" -parallel > "$resultsDir/mpi-restart/log.simpleFoam-stage2" 2>&1
grep -q '^End$' "$resultsDir/mpi-restart/log.simpleFoam-stage2"
grep -q "SIMPLE solution converged" "$resultsDir/mpi-restart/log.simpleFoam-stage2"
reconstructPar -case "$resultsDir/mpi-restart" -latestTime > "$resultsDir/mpi-restart/log.reconstructPar" 2>&1

echo "Comparing serial, restarted, and reconstructed MPI fields"
python3 "$tutorialDir/tools/compare_fields.py" --reference "$resultsDir/continuous" --candidate "$resultsDir/serial-restart" --candidate "$resultsDir/mpi-restart" --output "$resultsDir/summary.csv" --tolerance 5e-4 U p k omega nut fr1

: > "$resultsDir/continuous/continuous.foam"
: > "$resultsDir/serial-restart/serial-restart.foam"
: > "$resultsDir/mpi-restart/mpi-restart.foam"

elapsed=$(( $(date +%s) - startSeconds ))
printf 'Restart/MPI test time: %d min %d s\n' $((elapsed / 60)) $((elapsed % 60))
if [ "$elapsed" -gt 600 ]; then
    echo "ERROR: restart/MPI test exceeded 10 minutes" >&2
    exit 1
fi

echo "All serial-restart-MPI comparisons passed"
echo "Results: $resultsDir/summary.csv"
