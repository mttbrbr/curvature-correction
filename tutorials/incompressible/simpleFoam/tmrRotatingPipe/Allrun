#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

cd "${0%/*}" || exit 1
: "${WM_PROJECT_DIR:?OpenFOAM.com v2412 environment is not loaded}"

tutorial_dir=$(pwd)
repo_dir=$(cd "$tutorial_dir/../../../.." && pwd)
mode=${1:-smoke}

if [ "$mode" = validation ]; then
    if [ "${CURVATURE_SKIP_BUILD:-0}" != 1 ]; then
        wmake libso "$repo_dir/src/curvatureCorrectionModels"
    fi
    for validation_level in smoke quick medium
    do
        CURVATURE_SKIP_BUILD=1 CURVATURE_ROTATING_RESUME=1 \
            "$tutorial_dir/Allrun" "$validation_level"
    done
    python3 "$tutorial_dir/tools/analyse_frame_resolution.py" \
        --runs "$tutorial_dir/runs" --require-complete
    echo "Rotating-pipe validation results: $tutorial_dir/runs"
    exit 0
fi

case "$mode" in
    smoke)
        level=smoke
        expected_cells=98163
        ;;
    quick)
        level=quick
        expected_cells=238160
        ;;
    medium)
        level=medium
        expected_cells=854568
        ;;
    *)
        echo "ERROR: mode must be smoke, quick, medium or validation" >&2
        exit 2
        ;;
esac

if ! python3 "$repo_dir/tools/fetch_benchmark_data.py" \
    --case rotatingpipe --verify-only >/dev/null 2>&1; then
    echo "ERROR: rotating-pipe references are absent or invalid. Run:" >&2
    echo "  python3 tools/fetch_benchmark_data.py --case rotatingpipe" >&2
    exit 2
fi

if [ "${CURVATURE_SKIP_BUILD:-0}" != 1 ]; then
    wmake libso "$repo_dir/src/curvatureCorrectionModels"
fi

results="$tutorial_dir/runs/$mode"
mesh_case="$tutorial_dir/runs/_mesh-$level"
if [ "${CURVATURE_ROTATING_RESUME:-0}" != 1 ]; then
    rm -rf "$results"
fi
mkdir -p "$results"
mpi_procs=${CURVATURE_MPI_PROCS:-1}
case "$mpi_procs" in
    *[!0-9]*|'') echo "ERROR: CURVATURE_MPI_PROCS must be a positive integer" >&2; exit 2 ;;
    0) echo "ERROR: CURVATURE_MPI_PROCS must be a positive integer" >&2; exit 2 ;;
esac

if [ "${ROTATING_PIPE_REUSE_MESH:-0}" != 1 ] || \
   [ ! -d "$mesh_case/constant/polyMesh" ]; then
    rm -rf "$mesh_case"
    cp -a "$tutorial_dir/baseCase" "$mesh_case"
    python3 "$tutorial_dir/tools/generate_mesh.py" \
        --level "$level" --output "$mesh_case/system/blockMeshDict"
    blockMesh -case "$mesh_case" > "$mesh_case/log.blockMesh" 2>&1
    checkMesh -case "$mesh_case" -allTopology -allGeometry \
        > "$mesh_case/log.checkMesh" 2>&1
    grep -Eq "cells:[[:space:]]+$expected_cells$" "$mesh_case/log.checkMesh"
    grep -q "Number of regions: 1 (OK)" "$mesh_case/log.checkMesh"
    grep -q "Mesh OK" "$mesh_case/log.checkMesh"
    grep -Eq "rotating[[:space:]]+[0-9]+" "$mesh_case/log.checkMesh"
fi

run_case()
{
    rotation=$1
    omega_value=$2
    family=$3
    variant=$4
    frame=$5
    scheme=${6:-linearupwind}
    case_dir="$results/${rotation}-${family}-${variant}-${frame}"
    [ "$scheme" = linearupwind ] || case_dir="$case_dir-$scheme"

    case "$family:$variant" in
        sst:native) model=kOmegaSST ;;
        sst:on|sst:off) model=kOmegaSST2003RC ;;
        sa:native) model=SpalartAllmaras ;;
        sa:on|sa:off) model=SpalartAllmarasNoFt2RC ;;
        *) echo "ERROR: invalid model selection $family:$variant" >&2; exit 2 ;;
    esac

    echo "Running $mode $rotation $family-$variant $frame"
    if [ "${CURVATURE_ROTATING_RESUME:-0}" = 1 ] && \
       [ -f "$case_dir/log.simpleFoam" ] && \
       grep -q '^End$' "$case_dir/log.simpleFoam" && \
       [ -d "$case_dir/postProcessing/sampleProfiles" ]; then
        echo "Reusing completed case $case_dir"
        return
    fi
    rm -rf "$case_dir"
    cp -a "$tutorial_dir/baseCase" "$case_dir"
    cp -a "$mesh_case/constant/polyMesh" "$case_dir/constant/"
    cp -a "$case_dir/0.orig" "$case_dir/0"
    rm -f "$case_dir/constant/MRFProperties.template"
    if [ "$mode" = smoke ]; then
        foamDictionary "$case_dir/system/controlDict" \
            -entry endTime -set 1000 >/dev/null
        foamDictionary "$case_dir/system/controlDict" \
            -entry writeInterval -set 1000 >/dev/null
    fi

    foamDictionary "$case_dir/constant/turbulenceProperties" \
        -entry RAS/RASModel -set "$model" >/dev/null
    foamDictionary "$case_dir/0/U" \
        -entry boundaryField/rotatingWall/omega -set "$omega_value" >/dev/null

    sample_fields="U turbulenceProperties:R nut"
    if [ "$family" = sst ]; then
        sample_fields="$sample_fields k"
    fi
    if [ "$variant" != native ]; then
        correction=on
        [ "$variant" = off ] && correction=off
        if [ "$family" = sst ]; then
            coeffs=RAS/kOmegaSST2003RCCoeffs
        else
            coeffs=RAS/SpalartAllmarasNoFt2RCCoeffs
        fi
        foamDictionary "$case_dir/constant/turbulenceProperties" \
            -entry "$coeffs/curvatureCorrection" -set "$correction" >/dev/null
        sample_fields="$sample_fields fr1 OmegaRot curvatureIndicator productionBase productionCorrected productionRatio fr1Clipped"
    fi
    foamDictionary "$case_dir/system/sampleProfiles" \
        -entry fields -set "($sample_fields)" >/dev/null

    if [ "$scheme" = upwind ]; then
        foamDictionary "$case_dir/system/fvSchemes" \
            -entry 'divSchemes/div(phi,U)' \
            -set 'bounded Gauss upwind' >/dev/null
    elif [ "$scheme" != linearupwind ]; then
        echo "ERROR: unsupported scheme $scheme" >&2
        exit 2
    fi

    if [ "$frame" = mrf ]; then
        sed "s/@OMEGA@/$omega_value/g" \
            "$tutorial_dir/baseCase/constant/MRFProperties.template" \
            > "$case_dir/constant/MRFProperties"
    fi

    if [ "$mpi_procs" -gt 1 ]; then
        foamDictionary "$case_dir/system/decomposeParDict" \
            -entry numberOfSubdomains -set "$mpi_procs" >/dev/null
        decomposePar -case "$case_dir" -force \
            > "$case_dir/log.decomposePar" 2>&1
        mpirun -np "$mpi_procs" simpleFoam -case "$case_dir" -parallel \
            > "$case_dir/log.simpleFoam" 2>&1
        reconstructPar -case "$case_dir" -latestTime \
            > "$case_dir/log.reconstructPar" 2>&1
    else
        simpleFoam -case "$case_dir" > "$case_dir/log.simpleFoam" 2>&1
    fi
    grep -q '^End$' "$case_dir/log.simpleFoam"
    latest_time=$(foamListTimes -case "$case_dir" -latestTime)
    test -n "$latest_time"
    postProcess -case "$case_dir" -latestTime -func sampleProfiles \
        > "$case_dir/log.sampleProfiles" 2>&1
}

for family in sst sa
do
    run_case n06 200 "$family" native inertial
    run_case n06 200 "$family" native mrf
    run_case n06 200 "$family" on inertial
    run_case n06 200 "$family" on mrf
done

if [ "$mode" = quick ]; then
    for rotation_spec in "n0 0" "n03 100" "n06 200"
    do
        set -- $rotation_spec
        for family in sst sa
        do
            run_case "$1" "$2" "$family" native inertial
            run_case "$1" "$2" "$family" on inertial
        done
    done
    for family in sst sa
    do
        run_case n03 100 "$family" on mrf
        run_case n06 200 "$family" off mrf
    done
elif [ "$mode" = medium ]; then
    for rotation_spec in "n0 0" "n06 200"
    do
        set -- $rotation_spec
        for family in sst sa
        do
            run_case "$1" "$2" "$family" native inertial
            run_case "$1" "$2" "$family" on inertial
        done
    done
    for family in sst sa
    do
        run_case n06 200 "$family" native mrf upwind
        run_case n06 200 "$family" on mrf upwind
    done
fi

python3 "$tutorial_dir/tools/analyse.py" \
    --results "$results" \
    --references "$tutorial_dir/resources/reference" \
    --mode "$mode"
python3 "$tutorial_dir/tools/analyse_frame_resolution.py" \
    --runs "$tutorial_dir/runs"

echo "Rotating-pipe $mode results: $results"
