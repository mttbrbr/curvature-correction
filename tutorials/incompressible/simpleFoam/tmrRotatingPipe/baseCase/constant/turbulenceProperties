FoamFile
{
    format ascii;
    class dictionary;
    object turbulenceProperties;
}

simulationType RAS;

RAS
{
    RASModel kOmegaSST;
    turbulence on;
    printCoeffs on;

    kOmegaSST2003RCCoeffs
    {
        curvatureCorrection on;
        writeCurvatureDiagnostics on;
        Cr1 1.0;
        Cr2 2.0;
        Cr3 1.0;
        frMin 0.0;
        frMax 1.25;
    }

    SpalartAllmarasNoFt2RCCoeffs
    {
        curvatureCorrection on;
        writeCurvatureDiagnostics on;
        Cr1 1.0;
        Cr2 12.0;
        Cr3 1.0;
    }
}
