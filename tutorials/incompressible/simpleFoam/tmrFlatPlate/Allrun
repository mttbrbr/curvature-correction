#!/bin/sh
set -eu

cd "${0%/*}" || exit 1

: "${WM_PROJECT_DIR:?OpenFOAM environment is not loaded}"

tutorialDir=$(pwd)
repoDir=$(cd "$tutorialDir/../../../.." && pwd)
resultsDir="$tutorialDir/runs"
meshCase="$resultsDir/_mesh"
gridLevel=${1:-${TMR_FLATPLATE_GRID:-quick}}
startSeconds=$(date +%s)

if ! python3 "$repoDir/tools/fetch_benchmark_data.py" --case flatplate --verify-only >/dev/null; then
    echo "ERROR: benchmark inputs are absent or invalid. Run:" >&2
    echo "  python3 tools/fetch_benchmark_data.py --case flatplate" >&2
    exit 2
fi

case "$gridLevel" in
    quick)
        grid="$tutorialDir/resources/flatplate_69x49.p2dfmt"
        expectedCells=3264
        expectedWallFaces=56
        ;;
    medium)
        grid="$tutorialDir/resources/flatplate_137x97.p2dfmt"
        expectedCells=13056
        expectedWallFaces=112
        ;;
    *)
        echo "ERROR: TMR_FLATPLATE_GRID must be quick or medium" >&2
        exit 2
        ;;
esac

rm -rf "$resultsDir"
mkdir -p "$resultsDir"

if [ "${CURVATURE_SKIP_BUILD:-0}" != 1 ]; then
    echo "Building libcurvatureCorrectionModels.so"
    (cd "$repoDir/src/curvatureCorrectionModels" && wmake libso)
fi

echo "Preparing TMR 2DZP $gridLevel mesh"
cp -a "$tutorialDir/baseCase" "$meshCase"
plot3dToFoam -case "$meshCase" -2D 0.01 -noBlank "$grid" \
    > "$meshCase/log.plot3dToFoam" 2>&1
autoPatch -case "$meshCase" -overwrite 20 \
    > "$meshCase/log.autoPatch" 2>&1
topoSet -case "$meshCase" > "$meshCase/log.topoSet" 2>&1
createPatch -case "$meshCase" -overwrite -dict system/createPlatePatchDict \
    > "$meshCase/log.createPlatePatch" 2>&1
createPatch -case "$meshCase" -overwrite \
    > "$meshCase/log.createPatch" 2>&1
checkMesh -case "$meshCase" > "$meshCase/log.checkMesh" 2>&1
grep -q "cells: *$expectedCells" "$meshCase/log.checkMesh"
grep -q "Number of regions: 1 (OK)" "$meshCase/log.checkMesh"
grep -q "Max skewness = .* OK" "$meshCase/log.checkMesh"
grep -q "plate *$expectedWallFaces" "$meshCase/log.checkMesh"
grep -q "Failed 1 mesh checks" "$meshCase/log.checkMesh"

runCase()
{
    name=$1
    model=$2
    correction=${3:-native}
    caseDir="$resultsDir/$name"

    echo "Running $name ($model, correction=$correction)"
    cp -a "$tutorialDir/baseCase" "$caseDir"
    cp -a "$meshCase/constant/polyMesh" "$caseDir/constant/"
    cp -a "$caseDir/0.orig" "$caseDir/0"
    foamDictionary "$caseDir/constant/turbulenceProperties" \
        -entry RAS/RASModel -set "$model"

    case "$model" in
        kOmegaSSTCC)
            foamDictionary "$caseDir/constant/turbulenceProperties" \
                -entry RAS/kOmegaSSTCCCoeffs/curvatureCorrection \
                -set "$correction"
            ;;
        SpalartAllmarasCC)
            foamDictionary "$caseDir/constant/turbulenceProperties" \
                -entry RAS/SpalartAllmarasCCCoeffs/curvatureCorrection \
                -set "$correction"
            ;;
    esac

    potentialFoam -case "$caseDir" -writep \
        > "$caseDir/log.potentialFoam" 2>&1
    simpleFoam -case "$caseDir" > "$caseDir/log.simpleFoam" 2>&1
    grep -q '^End$' "$caseDir/log.simpleFoam"
    simpleFoam -case "$caseDir" -postProcess -latestTime \
        -func wallShearStress > "$caseDir/log.wallShearStress" 2>&1
}

runCase sst kOmegaSST
runCase sstcc-off kOmegaSSTCC off
runCase sstcc-on kOmegaSSTCC on
runCase sa SpalartAllmaras
runCase sacc-off SpalartAllmarasCC off
runCase sacc-on SpalartAllmarasCC on

python3 "$tutorialDir/tools/analyse.py" "$tutorialDir" "$grid"
python3 "$tutorialDir/../smitsCurve/tools/compare_fields.py" \
    --reference "$resultsDir/sst" \
    --candidate "$resultsDir/sstcc-off" \
    --output "$resultsDir/sst-off-fields.csv" \
    --tolerance 1e-12 U p k omega nut
python3 "$tutorialDir/../smitsCurve/tools/compare_fields.py" \
    --reference "$resultsDir/sa" \
    --candidate "$resultsDir/sacc-off" \
    --output "$resultsDir/sa-off-fields.csv" \
    --tolerance 1e-12 U p nuTilda nut

elapsed=$(( $(date +%s) - startSeconds ))
printf 'TMR 2DZP time: %d min %d s\n' $((elapsed / 60)) $((elapsed % 60))
if [ "$elapsed" -gt 1800 ]; then
    echo "ERROR: TMR 2DZP exceeded the 30-minute budget" >&2
    exit 1
fi

echo "Results: $resultsDir/summary.csv"
