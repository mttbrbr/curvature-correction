FoamFile { format ascii; class dictionary; object fvSolution; }
solvers
{
    p
    {
        solver GAMG;
        smoother GaussSeidel;
        tolerance 1e-8;
        relTol 0.05;
        cacheAgglomeration true;
        agglomerator faceAreaPair;
    }
    Phi
    {
        $p;
        relTol 0;
    }
    "(U|k|omega)"
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-7;
        relTol 0.05;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent yes;
    residualControl
    {
        p 1e-5;
        U 1e-5;
        k 1e-5;
        omega 1e-5;
    }
}
relaxationFactors
{
    fields { p 0.3; }
    equations { U 0.7; k 0.5; omega 0.5; }
}
